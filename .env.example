# Copy to .env and fill in locally. Never commit .env. Values below are placeholders only.

# --- Environment: development | test | paper | staging | production ---
APP_ENV=development
# BASE_CURRENCY=USD
# MARKETS=US            # comma-separated, e.g. US,IN
# DATA_PROVIDER=mock    # yahoo/mock are research-only and rejected for live trading
# BROKER=paper
# LOG_LEVEL=INFO
# MAX_MARKET_DATA_AGE_SECONDS=300

# --- Personal recommendation-only workflow (see docs/PERSONAL_RESEARCH.md) ---
# PERSONAL_RESEARCH=true     # Blocks order/cycle/cancel/recovery mutations, including PAPER execution
# INSTRUMENT_BOOTSTRAP=development  # Explicit bounded US/India master; requires PERSONAL_RESEARCH=true
# INSTRUMENT_MASTER_FILE=path/to/verified-master.json  # Alternative; do not combine with development profile
# Existing persisted instrument metadata is preserved. Restart API after imports.
# DATA_PROVIDER=yahoo        # Research-only OHLCV/quotes; no synthetic default mock prices
# API_TOKEN_FILE=secrets/local_dashboard.secret
# AI is optional for discovery, scanner, deterministic signals and snapshots.
# Without AI, final BUY/SHORT recommendations are withheld as AVOID with explicit reason.

# --- Docker (docker compose up --build) ---
# Compose reads this file for the non-secret values below. Secrets go in ./secrets/ (git-ignored):
# Compose AI/Finnhub credentials are read from secrets/ai_api_key.txt and
# secrets/finnhub_api_key.txt (empty while each provider is disabled).
#   secrets/db_password.txt   secrets/database_url.txt (postgresql://USER:PASSWORD@db:5432/DB)   secrets/api_token.txt
# POSTGRES_DB=trading
# POSTGRES_USER=trading_app
# ENTRY_WINDOW_START, ENTRY_WINDOW_END, MAX_POSITION_QUANTITY and MAX_ORDER_NOTIONAL (below) are required by compose.
# DATABASE_URL_FILE=/run/secrets/database_url   # alternative to DATABASE_URL for container secrets

# --- API (run: uvicorn stockmarket.api.bootstrap:create_app_from_env --factory) ---
# API_TOKEN=            # required in staging/production; protected endpoints are disabled without it
# ENTRY_WINDOW_START=   # instrument-local HH:MM, required by the API bootstrap (no built-in market hours)
# ENTRY_WINDOW_END=
# MAX_POSITION_QUANTITY=
# MAX_ORDER_NOTIONAL=
# PAPER_STARTING_CASH=100000
# FX_RATES=USD=1,INR=0.012

# --- Risk limits: defaults exist for development/test/paper; staging and production must set ALL ---
# RISK_PER_TRADE_PCT=0.005
# MAX_DAILY_LOSS_PCT=0.02
# MAX_DRAWDOWN_PCT=0.10
# MAX_POSITION_NOTIONAL_PCT=0.20
# MAX_TOTAL_NOTIONAL_PCT=1.0
# MAX_SECTOR_EXPOSURE_PCT=0.30
# MAX_CORRELATED_EXPOSURE_PCT=0.40
# MAX_LEVERAGE=1.0
# MAX_OPEN_POSITIONS=5
# MAX_TRADES_PER_DAY=10
# MAX_ORDERS_PER_MINUTE=10
# MIN_LIQUIDITY=1000000
# MAX_SLIPPAGE_BPS=20

# --- Execution mode (default is paper; live needs ALL of these plus the readiness checks) ---
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false
# LIVE_TRADING_CONFIRMATION=

# --- Database (use a least-privilege role; SQLite is for local development only) ---
DATABASE_URL=sqlite:///outputs/trading.db
# DATABASE_URL=postgresql://trading_app:CHANGE_ME@db:5432/trading

# --- Broker credentials (one prefix per configured broker, e.g. IBKR_) ---
# BROKER_API_KEY=
# BROKER_API_SECRET=
# BROKER_ACCOUNT_ID=
# Docker/Kubernetes secrets can be supplied as files instead: BROKER_API_SECRET_FILE=/run/secrets/broker_api_secret

# --- Data / news / AI providers ---
# Enable timestamped Finnhub company news for the AI research/orchestrator path.
# NEWS_PROVIDER=finnhub
# For provider symbols that differ from the platform's market symbols, supply
# explicit MARKET:SYMBOL mappings. US symbols default to identity mappings.
# FINNHUB_SYMBOL_MAP={"IN:RELIANCE":"RELIANCE.NS","IN:INFY":"INFY.NS"}
# Set all three to enable the OpenAI-compatible research provider.
# AI_BASE_URL=https://api.example.com/v1
# AI_MODEL=your-approved-model
# AI_API_KEY=                  # Secret; AI_API_KEY_FILE is also supported.
# Docker Compose reads the AI key from secrets/ai_api_key.txt.
# AI_TIMEOUT_SECONDS=20
# Set FUNDAMENTAL_PROVIDER=yahoo to include recent reported-EPS evidence only.
# It is research-only; untimestamped Yahoo sector/profile fields are not scored.
# FUNDAMENTAL_PROVIDER=yahoo
# Opt in to official NSE sector-index research observations for explicitly
# mapped NSE symbols only. Review membership yourself; unmapped symbols get no
# sector evidence. The NSE public site endpoint may rate-limit or block clients.
# SECTOR_PROVIDER=nse
# NSE_SECTOR_INDEX_MAP={"RELIANCE":"NIFTY OIL & GAS","INFY":"NIFTY IT"}
# JSON session rules by market. Omit a market until its session boundaries have
# been reviewed; market open/close and timezone are taken from core market data.
# Required per configured market: opening_range_minutes, entry_cutoff,
# square_off. Optional: entry_start, late_entry_start.
# RESEARCH_SESSIONS={"US":{"opening_range_minutes":15,"entry_cutoff":"15:00","square_off":"15:55","late_entry_start":"12:00"}}
