              },
              {
                "key": "cache-control",
                "value": "max-age=0"
              },
              {
                "key": "user-agent",
                "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/129.0.0.0 Safari/537.36 Edg/129.0.0.0"
              },
              {
                "key": "sec-ch-ua",
                "value": "\"Microsoft Edge\";v=\"129\", \"Not=A?Brand\";v=\"8\", \"Chromium\";v=\"129\""
              },
              {
                "key": "sec-ch-ua-mobile",
                "value": "?0"
              },
              {
                "key": "sec-ch-ua-platform",
                "value": "\"Windows\""
              },
              {
                "key": "sec-fetch-dest",
                "value": "document"
              },
              {
                "key": "sec-fetch-mode",
                "value": "navigate"
              },
              {
                "key": "sec-fetch-site",
                "value": "none"
              },
              {
                "key": "sec-fetch-user",
                "value": "?1"
              },
              {
                "key": "upgrade-insecure-requests",
                "value": "1"
              }
            ],
            "url": {
              "raw": "https://www.nseindia.com/api/historical/cm/equity?symbol={{nse_symbol}}&series=[\"EQ\"]&from={{hist_from}}&to={{hist_to}}",
              "protocol": "https",
              "host": ["www", "nseindia", "com"],
              "path": ["api", "historical", "cm", "equity"],
              "query": [
                {
                  "key": "symbol",
                  "value": "{{nse_symbol}}"
                },
                {
                  "key": "series",
                  "value": "[\"EQ\"]",
                  "description": "Keep brackets and quotes as shown"
                },
                {
                  "key": "from",
                  "value": "{{hist_from}}",
                  "description": "DD-MM-YYYY"
                },
                {
                  "key": "to",
                  "value": "{{hist_to}}",
                  "description": "DD-MM-YYYY"
                }
              ]
            },
            "description": "Used by market_learning via nsepython equity_history. JSON response has data[] array."
          },
          "response": []
        },
        {
          "name": "Bhavcopy full CSV (archives)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://archives.nseindia.com/products/content/sec_bhavdata_full_{{bhavcopy_ddmmyyyy}}.csv",
              "protocol": "https",
              "host": ["archives", "nseindia", "com"],
              "path": [
                "products",
                "content",
                "sec_bhavdata_full_{{bhavcopy_ddmmyyyy}}.csv"
              ]
            },
            "description": "Used by nse_intraday bhavcopy fallback. Date format DDMMYYYY (e.g. 29052026 for 29-May-2026). No session cookies usually required. Filter rows by SYMBOL column."
          },
          "response": []
        }
      ]
    },
