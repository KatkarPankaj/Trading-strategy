        {
          "name": "Warm-up — nseindia.com home",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "accept",
                "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"
              },
              {
                "key": "accept-language",
                "value": "en-US,en;q=0.9,en-IN;q=0.8,en-GB;q=0.7"
              },
              {
                "key": "cache-control",
                "value": "max-age=0"
              },
              {
                "key": "user-agent",
                "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/129.0.0.0 Safari/537.36 Edg/129.0.0.0"
              },
              {
                "key": "sec-ch-ua",
                "value": "\"Microsoft Edge\";v=\"129\", \"Not=A?Brand\";v=\"8\", \"Chromium\";v=\"129\""
              },
              {
                "key": "sec-ch-ua-mobile",
                "value": "?0"
              },
              {
                "key": "sec-ch-ua-platform",
                "value": "\"Windows\""
              },
              {
                "key": "sec-fetch-dest",
                "value": "document"
              },
              {
                "key": "sec-fetch-mode",
                "value": "navigate"
              },
              {
                "key": "sec-fetch-site",
                "value": "none"
              },
              {
                "key": "sec-fetch-user",
                "value": "?1"
              },
              {
                "key": "upgrade-insecure-requests",
                "value": "1"
              }
            ],
            "url": {
              "raw": "https://www.nseindia.com",
              "protocol": "https",
              "host": ["www", "nseindia", "com"]
            },
            "description": "Step 1 of 2 — establishes session cookies (same as nsepython nsefetch)."
          },
          "response": []
        },
        {
